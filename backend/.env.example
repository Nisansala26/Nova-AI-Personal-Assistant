# ==========================================
# Nova AI Assistant — Backend Configuration
# ==========================================

# Groq Cloud API Key (Get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Default: llama-3.3-70b-versatile, fallback: llama3-70b-8192)
GROQ_MODEL=llama-3.3-70b-versatile

# JWT Authentication Secret Key (Generate a random 32+ character string in production)
JWT_SECRET_KEY=nova-super-secret-key-change-in-production-min-32-chars

# Database URL (Defaults to SQLite in backend/app/database/assistant.db)
# DATABASE_URL=sqlite:///./app/database/assistant.db

# Optional: OpenWeatherMap API Key (Falls back to wttr.in live weather if empty)
# OPENWEATHER_API_KEY=
